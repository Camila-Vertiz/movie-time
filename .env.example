NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/Actions only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Without database credentials the application displays a labeled demo.
# Set false in production to fail closed when credentials are missing.
DEMO_MODE=true
# Scraping is opt-in after checking permission and terms for each source.
SCRAPER_ENABLED_CHAINS=garbo
SCRAPER_USER_AGENT=MovieTimeBot/1.0 (+https://your-project.vercel.app; contact: your-email@example.com)